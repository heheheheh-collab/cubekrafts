# ---------------------------------------------------------------------------
# Cubekrafts backend environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Database (Prisma / SQLite). Example for local dev:
DATABASE_URL="file:./dev.db"

# Server port (default 4000)
PORT=4000

# Node environment: "development" or "production".
# In production, error responses are generic (no internal detail leaked).
NODE_ENV=development

# --- Admin auth (ALL required; the server refuses to start without them) ---
# Admin login username.
ADMIN_USERNAME=admin
# bcrypt hash of the admin password (NOT the plaintext password).
# Generate one, e.g.:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'your-strong-password'
ADMIN_PASSWORD_HASH=
# Secret used to sign admin JWTs. MUST be at least 32 characters.
# Generate one, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=

# --- CORS ---
# Comma-separated list of allowed browser origins for cross-origin API calls.
# Example: https://prefab-finder-pro.lovable.app,http://localhost:5173
ALLOWED_ORIGINS=

# --- Error monitoring (optional) ---
# If set, Sentry is enabled. If unset, Sentry is fully skipped.
SENTRY_DSN=

# --- Outbound email (SMTP) for inquiry notifications ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Address that receives new-inquiry notifications.
ADMIN_EMAIL=
