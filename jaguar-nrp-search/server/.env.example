# Copy this file to .env and fill in real values. Never commit .env.

# Path to the SQLite database file (kept out of git; see .gitignore)
DATABASE_PATH=./data/jaguar-nrp.db

# Long random secret used to sign login sessions (JWTs).
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Port the API server listens on
PORT=4100

# Origin of the frontend that is allowed to call this API (for CORS + cookies)
CLIENT_ORIGIN=http://localhost:5173

# Set to "true" when serving over HTTPS in production, so login cookies
# are only ever sent over an encrypted connection.
COOKIE_SECURE=false
